# Copy to .env on the server (same folder as docker-compose.prod.yml)

# Required
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgresql://floridaeco:change-me-long-random@db:5432/floridaeco?schema=public
JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-long-random
ACME_EMAIL=you@floridaecoservices.com
PUBLIC_APP_URL=https://app.floridaecoservices.com
# Public URL of the site that reverse-proxies the API (used for email tracking links: /t/pixel and /t/click)
# In this repo, Caddy proxies /t/* to the API on floridaecoservices.com (see deploy/Caddyfile).
PUBLIC_API_URL=https://floridaecoservices.com

# Optional (CORS only needed if you call API cross-origin)
CORS_ORIGIN=https://app.floridaecoservices.com

# Optional SMTP (for sending contract links, etc.)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM="Florida Eco Services <noreply@floridaecoservices.com>"

# Optional Google/Gmail integration (inbox replies in CRM)
# Required if you want replies to appear in the CRM "Messages" modal (Gmail watch + Pub/Sub push).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://floridaecoservices.com/api/google/oauth/callback
# GOOGLE_WORKSPACE_EMAIL=eddy@floridaecoservices.com
# GOOGLE_GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/<topic-name>
# GOOGLE_PUBSUB_PUSH_AUDIENCE=https://floridaecoservices.com/api/google/gmail/push
# GOOGLE_PUBSUB_PUSH_SA_EMAIL=<push-subscription-service-account-email>

# Optional CRM worker tuning (email campaigns)
INSTANCE_ID=api-1
CRM_WORKER_INTERVAL_MS=10000
CRM_WORKER_BATCH=10
# Optional: spread scheduled emails to reduce burstiness (deliverability)
# Example: 900 = random delay between 0 and 15 minutes added to the scheduled send time.
CRM_SEND_JITTER_MAX_SECONDS=900
